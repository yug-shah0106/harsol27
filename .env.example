# Copy to .env and fill in. Never commit .env. The app refuses to start if any value is invalid.

# PostgreSQL. `pnpm dev:services` runs one in Docker with exactly these local-only settings.
DATABASE_URL="postgresql://harsol27:local-dev-password@127.0.0.1:5433/harsol27_dev"
# Separate database used by `pnpm test` and `pnpm test:e2e`. Tests wipe it.
TEST_DATABASE_URL="postgresql://harsol27:local-dev-password@127.0.0.1:5433/harsol27_test"

# Public origin of the site, no trailing slash: http://localhost:3000 locally,
# your ngrok domain (https://<name>.ngrok.app) on staging.
BETTER_AUTH_URL="http://localhost:3000"

# At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Header the nearest trusted proxy writes the client IP into:
# x-forwarded-for (local, ngrok, Caddy) · cf-connecting-ip (behind Cloudflare)
CLIENT_IP_HEADER="x-forwarded-for"

# Buyers and sellers sign in with email and password. Sign-in by SMS code is switched off (kept for
# later, docs/FUTURE.md), so SMS_PROVIDER and ALLOW_CONSOLE_SMS are no longer needed.

# "Continue with Google" (optional; the button is hidden while these are empty). Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (Web application), with the authorised redirect URI
# http://localhost:3000/api/auth/callback/google for local development. Set both or neither.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Document storage (S3-compatible). Locally: `pnpm dev:services` starts SeaweedFS with these keys.
# In production: a Cloudflare R2 bucket and an R2 API token. Then run `pnpm storage:setup` once.
S3_ENDPOINT="http://127.0.0.1:8333"
S3_BUCKET="harsol27-dev"
S3_ACCESS_KEY_ID="local-dev-access-key"
S3_SECRET_ACCESS_KEY="local-dev-secret-key-not-for-production"
# Tests use their own bucket so they never touch development files.
TEST_S3_BUCKET="harsol27-test"

# ── Background worker (`pnpm worker`) ──
RESEND_API_KEY=""
# Resend's shared test sender only delivers to your own Resend account address.
EMAIL_FROM="Harsol27 <onboarding@resend.dev>"
# Comma-separated staff addresses that receive new-lead alerts
TEAM_ALERT_EMAILS=""
