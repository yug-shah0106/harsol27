# Copy to deploy/.env for the Docker Compose stack. Never commit deploy/.env.

# Optional services: "ngrok" (public staging address), "local-s3" (no R2 yet; local only).
# Comma-separated, e.g. COMPOSE_PROFILES="ngrok". deploy/deploy.sh starts whatever is listed.
COMPOSE_PROFILES=""

# Public URL of this deployment, no trailing slash. Production: https://harsol27.com. With the ngrok
# profile (staging) this must be your reserved ngrok domain, e.g. https://harsol27.ngrok.app.
# Local only: http://localhost:3000
APP_URL="https://harsol27.com"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Database password. Use hex so it is safe inside a URL: openssl rand -hex 24
POSTGRES_PASSWORD=""

# x-forwarded-for behind ngrok · cf-connecting-ip once behind Cloudflare
CLIENT_IP_HEADER="x-forwarded-for"

# From https://dashboard.ngrok.com (only needed with --profile ngrok)
NGROK_AUTHTOKEN=""

# Buyers and sellers sign in with email and password. Sign-in by SMS code is switched off (kept for
# later, docs/FUTURE.md): leave SMS_PROVIDER and ALLOW_CONSOLE_SMS out.

# "Continue with Google" (optional; the button is hidden while these are empty). Google Cloud Console →
# APIs & Services → Credentials → Create credentials → OAuth client ID → Web application, with the
# authorised redirect URI <APP_URL>/api/auth/callback/google. Set both or neither.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Document storage. Production: a private Cloudflare R2 bucket + R2 API token, e.g.
#   S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# Without R2 (local only): start with --profile local-s3 and use
#   S3_ENDPOINT="http://s3:8333"  S3_PUBLIC_ENDPOINT="http://127.0.0.1:8333"
#   S3_ACCESS_KEY_ID="local-dev-access-key"  S3_SECRET_ACCESS_KEY="local-dev-secret-key-not-for-production"
# Then run once: docker compose -f deploy/compose.yml run --rm tools tsx scripts/storage-setup.ts
S3_ENDPOINT=""
S3_PUBLIC_ENDPOINT=""
S3_BUCKET="harsol27-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email (the worker refuses to start until these are valid)
RESEND_API_KEY=""
# Must be on a domain verified in Resend (harsol27.com), e.g. "Harsol27 <noreply@harsol27.com>"
EMAIL_FROM=""
# Comma-separated staff addresses that receive new-lead alerts
TEAM_ALERT_EMAILS=""

# ── Backups (deploy/backup) ────────────────────────────────────────────
# Nightly at BACKUP_AT_UTC (21:00 UTC = 02:30 India time), each one test-restored; the last
# BACKUP_KEEP_DAYS days are kept on this server.
BACKUP_AT_UTC="21:00"
BACKUP_KEEP_DAYS="14"
# Off-site copies, so a lost server does not mean lost data (required before launch). Use a
# SEPARATE private bucket, e.g. Cloudflare R2 "harsol27-backups", with its own API token limited to
# that bucket, and a lifecycle rule there that deletes copies after 90 days.
#   BACKUP_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
